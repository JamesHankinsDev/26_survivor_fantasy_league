rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is league member (by UID in members array)
    function isLeagueMember(leagueId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members;
    }

    // Helper: Is league owner
    function isLeagueOwner(leagueId) {
      return isAuthenticated() &&
        request.auth.uid == get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId;
    }

    // Helper: Is global admin (isAdmin field on user document)
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ========================================
    // LEAGUES COLLECTION
    // ========================================
    match /leagues/{leagueId} {
      // Read: members, owners, OR any authenticated user querying by joinCode
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.ownerId;

      // Update: owner, existing member, or a new user joining
      allow update: if isAuthenticated() && (
        // Owner can update anything
        request.auth.uid == resource.data.ownerId
        // Existing members can update (roster changes, tribe edits, etc.)
        || request.auth.uid in resource.data.members
        // New user joining: must be adding themselves to members and only
        // touching join-related fields
        || (
          !(request.auth.uid in resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberDetails', 'currentPlayers', 'updatedAt'])
        )
        // Admin can update any league (e.g. scoring updates)
        || isAdmin()
      );

      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.ownerId;

      // League message board
      match /messages/{messageId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if isLeagueMember(leagueId) &&
                         request.auth.uid == request.resource.data.authorId;
        // Author can edit any field (content, isEdited, editHistory, reactions)
        // Other members can only modify the reactions array (add/remove reactions)
        allow update: if isLeagueMember(leagueId) && (
                         request.auth.uid == resource.data.authorId
                         || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['reactions'])
                       );
        allow delete: if isLeagueMember(leagueId) &&
                         (request.auth.uid == resource.data.authorId ||
                          isLeagueOwner(leagueId));
      }
    }

    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() &&
                         request.auth.uid == userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ========================================
    // GLOBAL SEASONS COLLECTION
    // ========================================
    // Castaway profiles with events, scores, and elimination status
    match /seasons/{seasonNumber} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /castaways/{castawayId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // Permit cross-season collection group queries on `castaways`.
    // Required for the Hall of Fame, which queries every castaway across
    // every season subcollection in a single call.
    match /{path=**}/castaways/{castawayId} {
      allow read: if isAuthenticated();
    }

    // ========================================
    // SEASON OVERRIDES
    // ========================================
    // Admin-edited overlay on top of the static seasons list in src/data/seasons.ts.
    // Lets the admin update theme / premiereDate / mergeWeek / isActive / concludedAt
    // without a code deploy.
    match /seasonOverrides/{seasonNumber} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
