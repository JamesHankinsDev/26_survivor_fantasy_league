# push-service environment — copy to .env for local dev, or set these as
# service variables in Railway. See docs/push-notifications-setup.md.
#
# .env is gitignored. This template is not — never put real values here.

# The full SERVICE_ACCOUNT_KEY.json contents, minified to ONE line.
# Generate with:
#   node -e "console.log(JSON.stringify(require('./SERVICE_ACCOUNT_KEY.json')))" | pbcopy
FIREBASE_SERVICE_ACCOUNT=

# VAPID keypair. Not an account — a keypair you generate yourself (RFC 8292).
# The public key must match NEXT_PUBLIC_VAPID_PUBLIC_KEY on Vercel exactly,
# or browsers cannot subscribe.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Contact address for push providers. Nobody verifies it; no account is created.
VAPID_SUBJECT=mailto:you@example.com

# Optional tuning.
SWEEP_INTERVAL_MS=15000
BATCH_LIMIT=200

# Do NOT set PORT on Railway — it injects one. Local dev falls back to 8080.

# ── Thursday episode drafter (optional) ────────────────────────────────────
# Reads published recaps and DRAFTS the week's scoring for admin review.
# It never commits scores. Leave disabled until you've run backtest.js and
# are happy with the accuracy on Season 50.
ANTHROPIC_API_KEY=
EPISODE_SCORER_ENABLED=false
# Thu 13:00 UTC = 8am EST / 9am EDT. Episode airs Wed 8pm ET.
SCORER_UTC_HOUR=13
# Optional: pin the season. Defaults to the highest among active leagues.
SCORER_SEASON_NUMBER=
